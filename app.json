{
  "expo": {
    "name": "Book Reader",
    "slug": "book-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/reader-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.hackages.bookreader",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/reader-icon.png",
        "backgroundColor": "#173E48"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.hackages.bookreader"
    },
    "web": {
      "favicon": "./assets/reader-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F9F6",
          "image": "./assets/reader-icon.png",
          "imageWidth": 100
        }
      ]
    ],
    "owner": "hackages_group",
    "scheme": "hackages-bookreader",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "512c01a0-8b68-4279-9cc5-cafc3ea15d5b"
      }
    }
  }
}
